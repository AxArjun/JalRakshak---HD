# JalRakshak-HD Environment Template
# Copy this file to .env and configure local secrets. Do NOT commit .env.

# PostgreSQL / PostGIS Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jalrakshak_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Google Earth Engine Configuration
EARTH_ENGINE_PROJECT=jalrakshak-hd
